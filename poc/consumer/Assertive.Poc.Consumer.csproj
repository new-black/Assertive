<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Opt in to interceptors for the namespace our generator emits into. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Assertive.Poc.Generated</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Assertive.Poc.Generated</InterceptorsPreviewNamespaces>
    <!-- Dump generated sources to ./generated for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dump of generated files is for inspection only; don't compile it. -->
    <Compile Remove="generated/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../generator/Assertive.Poc.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
