<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Assertive.Mocking.Generated</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Assertive.Mocking.Generated</InterceptorsPreviewNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Assertive.Mocking\Assertive.Mocking.csproj" />
    <!-- Wired as an analyzer for source generation in the test project itself. -->
    <ProjectReference Include="..\Assertive.Mocking.Generators\Assertive.Mocking.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Also referenced as a regular assembly so GeneratorSnapshotTests can instantiate MockGenerator. -->
    <ProjectReference Include="..\Assertive.Mocking.Generators\Assertive.Mocking.Generators.csproj"
                      OutputItemType="Reference"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\Assertive.xUnit\Assertive.xUnit.csproj" />
  </ItemGroup>
</Project>
