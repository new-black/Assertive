<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Native AOT: also turns on the trim/AOT analyzers so IL2xxx/IL3xxx warnings
         surface for Assertive's reflection during publish. -->
    <PublishAot>true</PublishAot>
    <!-- What buildTransitive/Assertive.props does for package consumers; needed explicitly
         here because we reference the generator as a project, not via the package. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Assertive.Generated</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Assertive.Generated</InterceptorsPreviewNamespaces>
    <!-- Write generated sources to obj/.../generated for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- Rooting the app assembly keeps reflection metadata for compiler-generated display
       classes (lambda closures), which GeneratedAssert's decomposition reads by field
       name. Publish with -p:RootApp=false to test the fully-trimmed degradation; run the
       binary with the expect-degraded flag to pin that mode's behavior. -->
  <ItemGroup Condition="'$(RootApp)' != 'false'">
    <TrimmerRootAssembly Include="Assertive.Test.Aot" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assertive\Assertive.csproj" />
    <ProjectReference Include="..\Assertive.Generators\Assertive.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
