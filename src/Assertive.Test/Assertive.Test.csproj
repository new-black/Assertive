<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net11.0 pins the suite against the newer JIT's escape analysis: stack-allocated
         delegates/closures must not break reflective closure capture (GetCapturedValue). -->
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>

    <IsPackable>false</IsPackable>

    <Nullable>enable</Nullable>
<!--    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->

    <!-- Run this suite with the interceptor generator active: whitelisted equality
         assertions take the generated path (mirrors buildTransitive/Assertive.props). -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Assertive.Generated</InterceptorsNamespaces>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Assertive.Generated</InterceptorsPreviewNamespaces>
    <!-- Write generated sources to obj/.../generated for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffEngine" Version="15.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="FluentAssertions" Version="5.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.8.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assertive.xUnit\Assertive.xUnit.csproj" />
    <ProjectReference Include="..\Assertive\Assertive.csproj" />
    <ProjectReference Include="..\Assertive.Generators\Assertive.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
